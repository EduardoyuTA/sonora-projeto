# Frontend (Vercel) -> URL pública do backend FFmpeg hospedado no Render (sem barra no final)
# Exemplo: VITE_API_BASE_URL=https://sonora-ffmpeg-api.onrender.com
VITE_API_BASE_URL=

# Backend (Render) -> Domínio da Vercel permitido no CORS (ou * para permitir qualquer origem)
# Exemplo: CORS_ORIGIN=https://sonora-projeto.vercel.app
CORS_ORIGIN=*
PORT=3001
